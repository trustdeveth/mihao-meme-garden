{
  "name": "meme-garden",
  "private": true,
  "version": "0.1.0",
  "description": "Meme Garden: free multiplayer 3D garden game (server-authoritative; optional BNB Chain token layer, off by default)",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client",
    "tools"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "node --test \"shared/test/*.test.js\" \"server/test/*.test.js\" && node tools/budget/check-budgets.mjs",
    "test:shared": "node --test \"shared/test/*.test.js\"",
    "test:server": "node --test \"server/test/*.test.js\"",
    "build": "npm run build -w client",
    "start": "node server/src/index.js",
    "models": "node tools/models/run.mjs",
    "review": "node tools/models/run.mjs --no-textures",
    "icons": "node tools/icons/build-sprite.mjs && node tools/models/run.mjs --icons",
    "lint:ui": "node tools/ui-lint.mjs",
    "e2e": "node e2e/two-tab.mjs && node e2e/features.mjs",
    "e2e:memes": "node e2e/memes.mjs",
    "challenge": "node tools/challenge-admin.mjs",
    "shares": "node tools/share-admin.mjs",
    "showcase": "node e2e/showcase.mjs",
    "load": "node tools/load/bots.mjs",
    "chain:build": "node tools/chain/build.mjs",
    "chain:e2e": "node tools/chain/local-e2e.mjs",
    "chain:admin": "node tools/chain/admin.mjs",
    "dev:testnet": "node scripts/dev-testnet.mjs"
  }
}
